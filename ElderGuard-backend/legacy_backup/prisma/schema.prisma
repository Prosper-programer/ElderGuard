generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  password            String
  name                String
  role                String           // 'parent' | 'caregiver' | 'admin'
  phone               String?
  avatarUrl           String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  managedElderly      ElderlyProfile[] @relation("ParentManager")
  caregivingElderly   ElderlyProfile[] @relation("PrimaryCaregiver")
}

model ElderlyProfile {
  id                  String             @id @default(uuid())
  fullName            String
  preferredName       String
  age                 Int
  dateOfBirth         String
  gender              String
  height              String?
  weight              String?
  bloodType           String?
  address             String
  room                String?
  phone               String?
  imageUrl            String?            @db.Text
  
  parentManagerId     String
  parentManager       User               @relation("ParentManager", fields: [parentManagerId], references: [id])
  
  primaryCaregiverId  String?
  primaryCaregiver    User?              @relation("PrimaryCaregiver", fields: [primaryCaregiverId], references: [id])
  
  allergies           String?            @db.Text // JSON serialized array of strings
  conditions          String?            @db.Text // JSON serialized array of strings
  physicianName       String?
  physicianPhone      String?
  hospitalPreference  String?
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  emergencyContacts   EmergencyContact[]
  devices             Device[]
  vitals              VitalRecord[]
  alerts              AlertIncident[]
  medications         Medication[]
  careActivities      CareActivity[]
}

model EmergencyContact {
  id           String         @id @default(uuid())
  elderlyId    String
  elderly      ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  isPrimary    Boolean        @default(false)
}

model Device {
  id              String         @id @default(uuid())
  deviceId        String         @unique // e.g. "EG-IOT-4892"
  deviceName      String         @default("ElderGuard Smart Band")
  elderlyId       String
  elderly         ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  connected       Boolean        @default(true)
  batteryLevel    Int            @default(84)
  lastSync        DateTime       @default(now())
  signalStrength  String         @default("strong") // 'strong' | 'good' | 'weak'
  firmwareVersion String         @default("v2.4.1")
}

model VitalRecord {
  id           String         @id @default(uuid())
  elderlyId    String
  elderly      ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  heartRate    Int
  spo2         Int
  temperature  Float
  steps        Int            @default(0)
  activity     String         @default("Resting")
  gForce       Float          @default(1.0)
  fallDetected Boolean        @default(false)
  batteryPct   Int?
  latitude     Float?
  longitude    Float?
  geofenceZone String?
  timestamp    DateTime       @default(now())

  @@index([elderlyId, timestamp])
}

model AlertIncident {
  id              String         @id @default(uuid())
  elderlyId       String
  elderly         ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  type            String         // 'fall' | 'heart_rate' | 'spo2' | 'temperature' | 'geofence' | 'battery'
  severity        String         // 'critical' | 'warning' | 'info'
  status          String         @default("active") // 'active' | 'acknowledged' | 'resolved'
  title           String
  description     String         @db.Text
  location        String         @default("Living Room")
  latitude        Float?
  longitude       Float?
  heartRate       Int?
  spo2            Int?
  temperature     Float?
  impactGForce    Float?
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNotes String?        @db.Text
  timestamp       DateTime       @default(now())

  @@index([elderlyId, status])
}

model Medication {
  id           String           @id @default(uuid())
  elderlyId    String
  elderly      ElderlyProfile   @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  name         String
  dosage       String
  frequency    String
  instructions String           @db.Text
  timesOfDay   String           @db.Text // JSON string array e.g. '["08:00", "20:00"]'
  color        String?
  stock        Int              @default(30)
  createdAt    DateTime         @default(now())

  doses        MedicationDose[]
}

model MedicationDose {
  id            String      @id @default(uuid())
  medicationId  String
  medication    Medication  @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  scheduledTime String      // e.g. "08:00"
  period        String?     // e.g. "Morning"
  status        String      @default("pending") // 'pending' | 'taken' | 'missed'
  date          String      // YYYY-MM-DD
  takenAt       String?
  loggedBy      String?
  loggedAt      DateTime?
  notes         String?     @db.Text

  @@index([medicationId, date])
}

model CareActivity {
  id            String         @id @default(uuid())
  elderlyId     String
  elderly       ElderlyProfile @relation(fields: [elderlyId], references: [id], onDelete: Cascade)
  title         String
  category      String         // 'hydration' | 'mobility' | 'vital_check' | 'nutrition' | 'hygiene'
  target        Int
  current       Int            @default(0)
  unit          String
  status        String         @default("pending") // 'pending' | 'in_progress' | 'completed'
  notes         String?        @db.Text
  loggedBy      String?
  loggedAt      DateTime?
  scheduledTime String?
}
